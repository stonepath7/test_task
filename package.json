{
  "name": "dealeros-takeover",
  "version": "1.0.0",
  "private": true,
  "description": "Local dealership operating system takeover built around stock_id, SQLite, and workbook sync.",
  "scripts": {
    "dev": "tsx watch backend/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/backend/src/server.js",
    "smoke": "npm run build && node tests/smoke/smoke.mjs",
    "import:workbook": "tsx backend/src/scripts/importWorkbook.ts",
    "export:workbook": "tsx backend/src/scripts/exportWorkbook.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
